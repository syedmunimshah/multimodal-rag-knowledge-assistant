# LLM + embeddings provider
OPENAI_API_KEY=sk-...

# Postgres + pgvector connection (must have the `vector` extension enabled)
PG_CONNECTION_STRING=postgresql+psycopg://user:password@localhost:5432/rag_assistant
PG_COLLECTION_NAME=knowledge_base

# Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VISION_MODEL=gpt-4o-mini

# Retrieval / reasoning tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_REASONING_HOPS=3
